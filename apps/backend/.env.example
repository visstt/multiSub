# MultiSub Backend - Environment Variables
# Скопируйте этот файл: cp .env.example .env

# Сервер
APP_ENV=development
PORT=8080

# База данных PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multisub?sslmode=disable

# JWT
JWT_SECRET=dev-secret-change-in-production-min-32-chars
ACCESS_TOKEN_TTL=15
REFRESH_TOKEN_TTL=7

# Bcrypt
BCRYPT_COST=12

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=http://localhost:3000
